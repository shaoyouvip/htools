{
  "name": "htools",
  "version": "1.0.33",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "pages:dev": "node scripts/pages-dev.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:build": "node --test \"tests/build/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "test:browser": "node scripts/browser-regression.mjs flows",
    "test:categories": "node tests/browser/public-category-fallback.mjs",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "db:init:local": "wrangler d1 execute DB --local --config wrangler.local.toml --file db/schema.sql",
    "db:init:remote": "wrangler d1 execute DB --remote --config wrangler.local.toml --file db/schema.sql"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "postcss": "^8.5.26",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "wrangler": "^4.151.0"
  }
}
